{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:pdf": "tsx --test tests/pdf-content.test.ts",
    "test:pdf:ui": "playwright test",
    "test:formula": "tsx --test tests/formula-auth.test.ts tests/quota.test.ts",
    "test:telegram": "tsx --test tests/support-telegram.test.ts",
    "test:server": "tsc api/support-telegram.ts --module NodeNext --moduleResolution NodeNext --target ES2022 --outDir .server-check --skipLibCheck && node tests/server-smoke.mjs"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@google/genai": "^1.29.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.10.0",
    "firebase-admin": "^14.5.0",
    "jose": "^6.2.12",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/emscripten": "^1.41.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": "22.x"
  }
